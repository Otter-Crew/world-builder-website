---
import styles from './ArrowLink.module.css';

interface Props {
  href: string;
  size?: 'body' | 'lede';
  tone?: 'accent' | 'muted';
}
const { href, size = 'body', tone = 'accent' } = Astro.props;
---

<a class:list={[styles.arrowLink, size === 'lede' && styles.isLede, tone === 'muted' && styles.isMuted]} href={href}><slot /><span class={styles.arrow} aria-hidden="true">&rarr;</span></a>
