---
import type { ImageMetadata } from 'astro';
import aiModel from '../assets/screens/ai-model.png';
import characterContext from '../assets/screens/character-context.png';
import contextPane from '../assets/screens/context-pane.png';
import editorialOverview from '../assets/screens/editorial-overview.png';
import editorialReport from '../assets/screens/editorial-report.png';
import exportComplete from '../assets/screens/export-complete.png';
import grammarSuggestion from '../assets/screens/grammar-suggestion.png';
import revisionDiff from '../assets/screens/revision-diff.png';
import writingWorkspace from '../assets/screens/writing-workspace.png';
import ArrowLink from '../components/ArrowLink.astro';
import FaqItem from '../components/FaqItem.astro';
import Figure from '../components/Figure.astro';
import ProductHero from '../components/ProductHero.astro';
import Section from '../components/Section.astro';
import SectionMarker from '../components/SectionMarker.astro';
import StoryBeat from '../components/StoryBeat.astro';
import { home } from '../content/home';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';
import styles from './index.module.css';

const { hero, sections } = home;
// A beat renders text-only until its capture exists: the dictation beat has no
// `figure` at all, and `shots` is missing dictation.png. Both are deliberate.
const shots: Record<string, ImageMetadata> = {
  'ai-model': aiModel,
  'character-context': characterContext,
  'context-pane': contextPane,
  'editorial-overview': editorialOverview,
  'editorial-report': editorialReport,
  'export-complete': exportComplete,
  'grammar-suggestion': grammarSuggestion,
  'revision-diff': revisionDiff,
  'writing-workspace': writingWorkspace,
};
const machineShot = shots[sections.machine.figure.src];
const exportShot = shots[sections.export.beat.figure.src];
---

<BaseLayout>
  <ProductHero eyebrow={hero.eyebrow} title={hero.heading} lede={hero.lede}>
    <Fragment slot="actions">
      <ArrowLink href={site.store.href} size="lede">{hero.primary.label}</ArrowLink>
      <ArrowLink href={hero.secondary.href} tone="muted">{hero.secondary.label}</ArrowLink>
      <p class={styles.status}>{hero.status}</p>
    </Fragment>
    <Fragment slot="media">
      <Figure
        src={writingWorkspace}
        alt={hero.figure.alt}
        caption={hero.figure.caption}
        priority
        sizes="(max-width: 48rem) 100vw, 35rem"
      />
    </Fragment>
  </ProductHero>

  <Section id="writing" top="lg" bottom="xl" labelledby="writing-heading">
    <SectionMarker id="writing-heading" as="h2">{sections.writing.heading}</SectionMarker>
    <ol class={styles.beats} role="list">
      {sections.writing.beats.map((beat, index) => {
        const figure = 'figure' in beat ? beat.figure : undefined;
        const shot = figure && shots[figure.src];
        return (
          <StoryBeat title={beat.title} description={beat.description} media={index % 2 === 0 ? 'right' : 'left'}>
            {figure && shot && <Figure slot="media" src={shot} alt={figure.alt} caption={figure.caption} />}
          </StoryBeat>
        );
      })}
    </ol>
  </Section>

  <Section id="editorial" top="xl" bottom="xl" labelledby="editorial-heading">
    <SectionMarker id="editorial-heading" as="h2">{sections.editorial.heading}</SectionMarker>
    <ol class={styles.beats} role="list">
      {sections.editorial.beats.map((beat, index) => {
        const shot = shots[beat.figure.src];
        return (
          <StoryBeat title={beat.title} description={beat.description} media={index % 2 === 0 ? 'right' : 'left'}>
            {shot && <Figure slot="media" src={shot} alt={beat.figure.alt} caption={beat.figure.caption} />}
          </StoryBeat>
        );
      })}
    </ol>
  </Section>

  <Section id="ownership" top="xl" bottom="xl" width="content" labelledby="ownership-heading">
    <div class={styles.ownership}>
      <div class={styles.ownershipCopy}>
        <SectionMarker id="ownership-heading" as="h2">{sections.ownership.heading}</SectionMarker>
        <p>{sections.ownership.body}</p>
        <p>{sections.ownership.privacy}</p>
      </div>
      <p class={styles.ownershipCaption}>{sections.ownership.caption}</p>
    </div>
  </Section>

  <Section id="machine" top="xl" bottom="xl" labelledby="machine-heading">
    <SectionMarker id="machine-heading" as="h2">{sections.machine.heading}</SectionMarker>
    <ol class={styles.beats} role="list">
      <StoryBeat title={sections.machine.beatTitle} description={sections.machine.body} media="right">
        {machineShot && (
          <Figure
            slot="media"
            src={machineShot}
            alt={sections.machine.figure.alt}
            caption={sections.machine.figure.caption}
          />
        )}
      </StoryBeat>
    </ol>
  </Section>

  <Section id="export" top="xl" bottom="xl" labelledby="export-heading">
    <SectionMarker id="export-heading" as="h2">{sections.export.heading}</SectionMarker>
    <ol class={styles.beats} role="list">
      <StoryBeat title={sections.export.beat.title} description={sections.export.beat.description} media="left">
        {exportShot && (
          <Figure
            slot="media"
            src={exportShot}
            alt={sections.export.beat.figure.alt}
            caption={sections.export.beat.figure.caption}
          />
        )}
      </StoryBeat>
    </ol>
  </Section>

  <Section id="audience" top="xl" bottom="xl" width="content" labelledby="audience-heading">
    <div class={styles.ownershipCopy}>
      <SectionMarker id="audience-heading" as="h2">{sections.audience.heading}</SectionMarker>
      <p>{sections.audience.body}</p>
    </div>
  </Section>

  <Section top="xl" bottom="xl" width="content" labelledby="questions">
    <SectionMarker id="questions" as="h2">{sections.faq.heading}</SectionMarker>
    <div>
      {sections.faq.items.map((item) => <FaqItem question={item.question}><p>{item.answer}</p></FaqItem>)}
    </div>
  </Section>

  <Section id="store" top="xl" bottom="2xl" width="content" labelledby="store-heading">
    <div class={styles.closing}>
      <SectionMarker id="store-heading" as="h2">{sections.store.heading}</SectionMarker>
      <p>{sections.store.body}</p>
      <p><ArrowLink href={site.store.href} size="lede">{site.store.label}</ArrowLink></p>
    </div>
  </Section>
</BaseLayout>
