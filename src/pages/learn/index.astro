---
import { getCollection } from 'astro:content';
import Section from '../../components/Section.astro';
import SectionMarker from '../../components/SectionMarker.astro';
import { slugOf } from '../../content/guides';
import BaseLayout from '../../layouts/BaseLayout.astro';
import styles from './learn.module.css';

const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Learn" description="Fourteen short guides to World Builder, one per job: set up a world, link prose to it, review a chapter, keep history, dictate, export a book.">
  <Section top="2xl" bottom="lg" width="content">
    <SectionMarker>Learn</SectionMarker>
    <h1 class={styles.title}>Learn World Builder.</h1>
    <p class={styles.lede}>One guide per job. Start at the top if the app is new to you; otherwise pick the one you came for.</p>
  </Section>
  <Section top="lg" bottom="2xl" width="content" labelledby="guides">
    <SectionMarker id="guides" as="h2">Guides</SectionMarker>
    <ol class={styles.list} role="list">
      {guides.map((guide) => (
        <li class={styles.item}>
          <a class={styles.link} href={`/learn/${slugOf(guide.id)}/`}>{guide.data.title}</a>
          <p class={styles.description}>{guide.data.description}</p>
          <p class={styles.outcome}>{guide.data.outcome}</p>
        </li>
      ))}
    </ol>
  </Section>
</BaseLayout>
